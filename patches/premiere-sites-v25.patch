+++ sites-v25-new/app/api/premiere/register/route.ts	2026-10-27 13:16:43.429238614 +0000
@@ -0,0 +1,18 @@
+import { digest } from '../../../../lib/payuni/core';
+import { json } from '../../../../lib/payuni/server';
+import { bumpLimit, dbInsertRegistrant, readJson, registrantInput, sameOrigin } from '../../../../lib/premiere/roster';
+
+export async function POST(request: Request) {
+ if (!sameOrigin(request)) return json({ error: '請從本頁送出報名。' }, 403);
+ let body: Record<string, unknown>;
+ try { body = await readJson(request); } catch { return json({ error: '請重新填寫。' }, 400); }
+ let person: ReturnType<typeof registrantInput>;
+ try { person = registrantInput(body); } catch (error) { return json({ error: error instanceof Error ? error.message : '請重新填寫。' }, 400); }
+ try {
+  const minute = Math.floor(Date.now() / 60000);
+  const ip = request.headers.get('cf-connecting-ip') || 'unknown';
+  if (!await bumpLimit('premiere-ip:' + digest(ip + ':' + minute), 30)) return json({ error: '送出次數較多，請稍候一分鐘再試。' }, 429);
+  if (!await bumpLimit('premiere-email:' + digest(person.email + ':' + minute), 5)) return json({ error: '送出次數較多，請稍候一分鐘再試。' }, 429);
+  return await dbInsertRegistrant(person);
+ } catch { return json({ error: '暫時無法登記，請稍後再試。' }, 503); }
+}
