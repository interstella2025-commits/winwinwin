+export const PRECOURSE_PRODUCT = 'WIN 講師班｜90分鐘線上前導課';
+export const FULLCOURSE_PRODUCT = '【待 Elsa 確認】WIN 講師班正式課程';
+
+export type PaymentSnapshot = {
+  status?: string;
+  amount?: number;
+  plan?: string | null;
+  isTest?: boolean;
+  productName?: string | null;
+  session?: string | null;
+} | null;
+
+export type PaymentView = {
+  title: string;
+  productLine: string | null;
+  body: string;
+  note: string;
+  showSession: boolean;
+};
+
+export function productNameForPlan(plan: string | null | undefined) {
+  if (plan === 'test') return 'WIN 金流驗收測試';
+  if (plan === 'precourse') return PRECOURSE_PRODUCT;
+  if (plan === 'fullcourse') return FULLCOURSE_PRODUCT;
+  return '【待確認】款項';
+}
+
+export function paymentView(result: PaymentSnapshot, failed = false): PaymentView {
+  if (!result) {
+    return {
+      title: failed ? '無法確認付款結果' : '正在讀取付款結果',
+      productLine: null,
+      body: '',
+      note: '',
+      showSession: false,
+    };
+  }
+  const plan = result.plan === 'test' || result.plan === 'precourse' || result.plan === 'fullcourse' || result.plan === 'unknown'
+    ? result.plan
+    : result.isTest ? 'test' : result.amount === 399 ? 'precourse' : 'unknown';
+  const amount = typeof result.amount === 'number' ? `NT$${result.amount}` : '';
+  const paid = result.status === 'paid';
+  const pending = result.status === 'pending';
+  const product = plan === 'precourse'
+    ? PRECOURSE_PRODUCT
+    : plan === 'test'
+      ? 'WIN 金流驗收測試'
+      : plan === 'fullcourse'
+        ? (result.productName || FULLCOURSE_PRODUCT)
+        : (result.productName || '【待確認】款項');
+  const title = plan === 'fullcourse'
+    ? (paid ? '【待 Elsa 確認】正式課程付款成功' : pending ? '【待 Elsa 確認】正在確認正式課程付款' : '【待 Elsa 確認】正式課程付款結果')
+    : plan === 'unknown'
+      ? (paid ? '【待確認】付款已收到' : pending ? '【待確認】正在確認付款' : '【待確認】付款結果')
+      : (paid ? (plan === 'test' ? '測試付款成功' : '前導課付款成功') : pending ? '正在確認付款結果' : 'WIN 前導課付款結果');
+  const body = paid
+    ? (plan === 'test'
+      ? 'NT$1 測試付款已完成。此為金流驗收，不包含課程報名或席位。'
+      : plan === 'fullcourse'
+        ? '【待 Elsa 確認】已收到正式課程款項。後續通知方式尚未定稿。'
+        : plan === 'unknown'
+          ? '【待確認】已收到款項。請保留訂單編號，並等候主辦方核對課程方案。'
+          : '已收到你的 NT$399 前導課款項。線上課程的實際安排與上課連結將另行通知。')
+    : pending
+      ? '正在確認付款結果，請稍候；若已付款，請勿重複付款。'
+      : result.status === 'expired'
+        ? '這筆付款連結已逾時。若已完成付款，請稍後重新整理查詢。'
+        : '目前尚未確認付款成功。若已扣款，請勿重複付款，請保留訂單編號。';
+  const note = plan === 'test'
+    ? '此為 NT$1 測試付款，不包含課程報名。'
+    : plan === 'fullcourse'
+      ? '【待 Elsa 確認】此付款結果頁的正式課程說明尚未定稿。'
+      : plan === 'unknown'
+        ? '【待確認】這筆訂單的課程方案尚未核對完成。'
+        : '此款項僅為線上前導課，不代表正式講師班錄取或費用。';
+  return {
+    title,
+    productLine: amount ? `${product} · ${amount}` : product,
+    body,
+    note,
+    showSession: plan === 'precourse' && !result.isTest,
+  };
+}
