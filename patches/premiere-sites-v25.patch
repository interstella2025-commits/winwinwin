diff -ruN sites-v25-base/app/api/premiere/attend/route.ts sites-v25-new/app/api/premiere/attend/route.ts
--- sites-v25-base/app/api/premiere/attend/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ sites-v25-new/app/api/premiere/attend/route.ts	2026-10-27 13:16:43.429238614 +0000
@@ -0,0 +1,18 @@
+import { digest } from '../../../../lib/payuni/core';
+import { db, json } from '../../../../lib/payuni/server';
+import { bumpLimit, readJson, sameOrigin } from '../../../../lib/premiere/roster';
+
+export async function POST(request: Request) {
+ if (!sameOrigin(request)) return json({ error: '請從本頁送出報名。' }, 403);
+ let body: Record<string, unknown>;
+ try { body = await readJson(request); } catch { return json({ error: '請重新填寫。' }, 400); }
+ const token = typeof body.token === 'string' ? body.token.trim() : '';
+ if (!/^[0-9a-f-]{36}$/i.test(token)) return json({ error: '找不到登記資料。' }, 404);
+ try {
+  if (!await bumpLimit('premiere-attend:' + digest(token + ':' + Math.floor(Date.now() / 60000)), 10)) return json({ error: '送出次數較多，請稍候一分鐘再試。' }, 429);
+  const found = await db().prepare('SELECT id FROM premiere_registrants WHERE token=?').bind(token).first<{ id: string }>();
+  if (!found) return json({ error: '找不到登記資料。' }, 404);
+  await db().prepare('UPDATE premiere_registrants SET joined_at=? WHERE token=? AND joined_at IS NULL').bind(new Date().toISOString(), token).run();
+  return json({ ok: true });
+ } catch { return json({ error: '暫時無法記錄進入時間，請稍後再試。' }, 503); }
+}
