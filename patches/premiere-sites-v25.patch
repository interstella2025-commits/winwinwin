+
+export async function GET(request: Request) {
+ if (!exportAuthorized(request)) return json({ error: 'Not found' }, 404);
+ try {
+  return new Response(await rosterCsv(), { headers: { 'Content-Type': 'text/csv; charset=utf-8', 'Content-Disposition': 'attachment; filename="premiere-roster.csv"', 'Cache-Control': 'no-store', 'Referrer-Policy': 'no-referrer' } });
+ } catch { return json({ error: '暫時無法匯出。' }, 503); }
