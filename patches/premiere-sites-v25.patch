+import { exportAuthorized, sameOrigin } from '../../../../lib/premiere/roster';
+import { listMessages, saveMessages } from '../../../../lib/premiere/script';
+import { json } from '../../../../lib/payuni/server';
+
+export async function GET() {
+  return json({ messages: await listMessages() });
+}
+
+export async function POST(request: Request) {
+  if (!exportAuthorized(request)) return new Response('Not found', { status: 404 });
+  if (!sameOrigin(request)) return json({ error: '請從本頁送出。' }, 403);
+  try {
+    return await saveMessages(request);
+  } catch (error) {
+    return json({ error: error instanceof Error ? error.message : '無法儲存訊息。' }, 400);
+  }
+}
diff -ruN '--exclude=node_modules' '--exclude=.next' '--exclude=.git' sites-v25-base/app/api/premiere/register/route.ts sites-v25-new/app/api/premiere/register/route.ts
