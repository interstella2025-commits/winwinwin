+function callback(values) { const EncryptInfo = core.encrypt(values, cfg); return new Request(origin + '/api/payuni/notify', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ MerID: cfg.merchant, Version: core.VERSION, EncryptInfo, HashInfo: core.hash(EncryptInfo, cfg) }) }); }
+function signup(body, requestOrigin = origin) { return new Request(origin + '/api/premiere/register', { method: 'POST', headers: { Origin: requestOrigin, 'Content-Type': 'application/json', 'cf-connecting-ip': '192.0.2.30' }, body: JSON.stringify(body) }); }
+(async () => {
