@@ -0,0 +1,71 @@
+import { env } from 'cloudflare:workers';
+import { timingSafeEqual } from 'node:crypto';
+import { digest, PREMIERE_SESSION, PRODUCTS } from '../payuni/core';
+import { db, json } from '../payuni/server';
+
+export async function readJson(request: Request, limit = 8000) {
+ if (Number(request.headers.get('content-length') || 0) > limit) throw new Error('請重新填寫。');
+ const text = await request.text();
+ if (text.length > limit) throw new Error('請重新填寫。');
+ const body = JSON.parse(text);
+ if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error('請重新填寫。');
+ return body as Record<string, unknown>;
+}
+export function sameOrigin(request: Request) {
+ const origin = request.headers.get('origin');
+ return !!origin && origin === new URL(request.url).origin;
+}
+export async function bumpLimit(bucket: string, max: number) {
+ const rate = await db().prepare('INSERT INTO payment_rate_limits (bucket,attempts) VALUES (?,1) ON CONFLICT(bucket) DO UPDATE SET attempts=attempts+1 RETURNING attempts').bind(bucket).first<{ attempts: number }>();
+ return !!rate && rate.attempts <= max;
+}
+export function registrantInput(body: Record<string, unknown>) {
+ if (body.website) throw new Error('請重新填寫。');
+ const name = typeof body.name === 'string' ? body.name.trim() : '';
+ const email = typeof body.email === 'string' ? body.email.trim().toLowerCase() : '';
+ const sessionCode = typeof body.sessionCode === 'string' ? body.sessionCode.trim() : '';
+ if (!name || name.length > 100 || email.length > 200 || !/^\S+@\S+\.\S+$/.test(email) || sessionCode !== PREMIERE_SESSION) throw new Error('請填寫姓名、有效 Email。');
+ return { name, email, sessionCode };
+}
+export async function dbInsertRegistrant(person: { name: string; email: string; sessionCode: string }) {
+ const token = crypto.randomUUID();
+ const now = new Date().toISOString();
+ try {
+  await db().prepare('INSERT INTO premiere_registrants (id,name,email,session_code,token,created_at) VALUES (?,?,?,?,?,?)').bind(crypto.randomUUID(), person.name, person.email, person.sessionCode, token, now).run();
+  return json({ ok: true, token });
+ } catch {
+  const existing = await db().prepare('SELECT token FROM premiere_registrants WHERE email=? AND session_code=?').bind(person.email, person.sessionCode).first<{ token: string }>();
+  if (!existing?.token) return json({ error: '暫時無法登記，請稍後再試。' }, 503);
+  return json({ ok: true, already: true });
+ }
+}
+export function exportAuthorized(request: Request) {
+ const secret = env.PREMIERE_EXPORT_TOKEN;
+ const header = request.headers.get('authorization') || '';
+ if (!secret || !header || header.length > 500 || secret.length > 500) return false;
+ return timingSafeEqual(Buffer.from(digest(header)), Buffer.from(digest('Bearer ' + secret)));
+}
+function cell(value: unknown) {
+ const text = value == null ? '' : String(value);
+ const safe = /^[=+\-@\t\r]/.test(text) ? `'${text}` : text;
+ return `"${safe.replaceAll('"', '""')}"`;
+}
+const CSV_NOTE = '這份名單以既有報名表為主，不使用 premiere_registrants。登記與付款若不是同一個 Email，報名那一列會顯示沒買；有付款的那個 Email 若沒有報名紀錄，會另外列成一筆。';
+type RosterRow = { name: string; email: string; phone: string; session_code: string | null; created_at: string; order_no: string | null; paid_amount: number | null; intro_paid: number | null; source: string };
+export async function rosterCsv() {
+ const full = PRODUCTS.fullcourse.amount;
+ const intro = PRODUCTS.precourse.amount;
+ const bought = `o.status='paid' AND (o.plan='fullcourse' OR o.amount=?)`;
+ const rows = await db().prepare(`SELECT a.name AS name, lower(trim(a.email)) AS email, a.phone AS phone, a.session_code AS session_code, a.created_at AS created_at,
+  (SELECT o.order_no FROM applications a4 JOIN payment_orders o ON o.application_id=a4.id WHERE lower(trim(a4.email))=lower(trim(a.email)) AND ${bought} ORDER BY o.paid_at DESC LIMIT 1) AS order_no,
+  (SELECT o.amount FROM applications a4 JOIN payment_orders o ON o.application_id=a4.id WHERE lower(trim(a4.email))=lower(trim(a.email)) AND ${bought} ORDER BY o.paid_at DESC LIMIT 1) AS paid_amount,
+  (SELECT 1 FROM applications a4 JOIN payment_orders o ON o.application_id=a4.id WHERE lower(trim(a4.email))=lower(trim(a.email)) AND o.status='paid' AND o.amount=? LIMIT 1) AS intro_paid,
+  '報名表' AS source
+  FROM applications a
+  WHERE a.rowid=(SELECT a2.rowid FROM applications a2 WHERE lower(trim(a2.email))=lower(trim(a.email)) ORDER BY a2.created_at DESC LIMIT 1)
+  ORDER BY a.created_at ASC`).bind(full, full, intro).all<RosterRow>();
+ const header = ['姓名', 'Email', '電話', '場次', '報名時間', '是否購買', '訂單編號', '付款金額', '前導課已付款', '來源'];
+ const line = (row: RosterRow) => [row.name, row.email, row.phone, row.session_code ?? '', row.created_at, row.paid_amount == null ? '沒買' : '有買', row.order_no ?? '', row.paid_amount ?? '', row.intro_paid ? '是' : '否', row.source].map(cell).join(',');
+ const lines = [header.map(cell).join(','), ...(rows.results || []).map(line), ['注意', CSV_NOTE, '', '', '', '', '', '', '', ''].map(cell).join(',')];
+ return '\uFEFF' + lines.join('\r\n');
+}
