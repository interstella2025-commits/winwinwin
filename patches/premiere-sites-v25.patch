@@ -0,0 +1,73 @@
+import { db, json } from '../payuni/server';
+import { readJson } from './roster';
+
+export const MESSAGE_KINDS = ['announcement', 'feedback', 'note'] as const;
+export type MessageKind = (typeof MESSAGE_KINDS)[number];
+export type PremiereMessage = { id: string; displayName: string; avatarUrl: string; body: string; appearSeconds: number; kind: MessageKind };
+
+const MAX_MESSAGES = 300;
+
+export function parseTimestamp(value: string) {
+  const match = /^(\d{1,2}):([0-5]\d):([0-5]\d)$/.exec(value.trim());
+  if (!match) return null;
+  const seconds = Number(match[1]) * 3600 + Number(match[2]) * 60 + Number(match[3]);
+  if (seconds > 24 * 3600) return null;
+  return seconds;
+}
+
+function cleanAvatar(value: unknown) {
+  if (typeof value !== 'string') return '';
+  const text = value.trim();
+  if (!text) return '';
+  if (text.length > 300) throw new Error('頭像網址太長。');
+  if (text.startsWith('/') && !text.startsWith('//')) return text;
+  try {
+    const url = new URL(text);
+    if (url.protocol !== 'https:') throw new Error('頭像只接受 https 網址。');
+    return url.toString();
+  } catch (error) {
+    if (error instanceof Error && error.message.includes('頭像')) throw error;
+    throw new Error('頭像網址無法使用。');
+  }
+}
+
+export function parseMessageList(value: unknown): PremiereMessage[] {
+  if (!Array.isArray(value)) throw new Error('請提供訊息清單。');
+  if (value.length > MAX_MESSAGES) throw new Error('訊息太多。');
+  return value.map((item, index) => {
+    if (!item || typeof item !== 'object' || Array.isArray(item)) throw new Error(`第 ${index + 1} 則訊息無法讀取。`);
+    const row = item as Record<string, unknown>;
+    const displayName = typeof row.displayName === 'string' ? row.displayName.trim() : '';
+    const body = typeof row.body === 'string' ? row.body.trim() : '';
+    const kind = row.kind;
+    const appear = typeof row.appearSeconds === 'number' ? row.appearSeconds : typeof row.appear === 'string' ? parseTimestamp(row.appear) : null;
+    if (!displayName || displayName.length > 40 || !body || body.length > 400) throw new Error(`第 ${index + 1} 則訊息的名字或內容不符合長度。`);
+    if (appear == null || !Number.isInteger(appear) || appear < 0) throw new Error(`第 ${index + 1} 則訊息的時間請用 00:00:00。`);
+    if (typeof kind !== 'string' || !MESSAGE_KINDS.includes(kind as MessageKind)) throw new Error(`第 ${index + 1} 則訊息的類型不正確。`);
+    const id = typeof row.id === 'string' && /^[0-9a-f-]{36}$/i.test(row.id) ? row.id : crypto.randomUUID();
+    return { id, displayName, avatarUrl: cleanAvatar(row.avatarUrl), body, appearSeconds: appear, kind: kind as MessageKind };
+  });
+}
+
+export async function listMessages() {
+  try {
+    const rows = await db().prepare('SELECT id, display_name AS displayName, avatar_url AS avatarUrl, body, appear_seconds AS appearSeconds, kind FROM premiere_messages ORDER BY appear_seconds ASC, rowid ASC').all<PremiereMessage>();
+    return rows.results || [];
+  } catch {
+    return [];
+  }
+}
+
+export async function replaceMessages(messages: PremiereMessage[]) {
+  await db().prepare('DELETE FROM premiere_messages').run();
+  for (const message of messages) {
+    await db().prepare('INSERT INTO premiere_messages (id, display_name, avatar_url, body, appear_seconds, kind) VALUES (?,?,?,?,?,?)').bind(message.id, message.displayName, message.avatarUrl, message.body, message.appearSeconds, message.kind).run();
+  }
+}
+
+export async function saveMessages(request: Request) {
+  const body = await readJson(request, 200000);
+  const messages = parseMessageList(body.messages);
+  await replaceMessages(messages);
+  return json({ ok: true, count: messages.length });
+}
