# WIN 講師班 payment backend. Copy to Vercel env (mark keys Sensitive). Never commit real values.
# --- Elsa supplies (PAYUNi merchant dashboard) ---
PAYUNI_MER_ID=
PAYUNI_HASH_KEY=          # 32 chars
PAYUNI_HASH_IV=           # 16 chars
# --- Elsa supplies (Resend; sending domain must be verified) ---
RESEND_API_KEY=
# Sender is fixed in code: WIN講師班 <noreply@mail.win-lin.com> (Resend domain mail.win-lin.com must be verified). No reply-to.
# --- We generate ---
PAYUNI_TEST_ACCESS=       # random 32+ byte secret; Bearer token for POST /api/payuni/test/create
DATABASE_URL=             # injected by the Neon Marketplace integration
# --- Optional ---
PAYUNI_TEST_EMAIL=        # NT$1 test receipt address (default floraloasis0211@gmail.com)
PAYUNI_API_ENDPOINT=      # default https://api.payuni.com.tw/api/upp (sandbox: https://sandbox-api.payuni.com.tw/api/upp)
# --- Optional: Meta Pixel (browser) + Conversions API (server). Both no-op when empty. ---
# Dataset / Pixel ID. Public. Do not hardcode it in source; set it here and in Vercel.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token. Server-only. Mark Sensitive in Vercel. Never commit a real value.
# Checkout and PAYUNi notify still succeed when this is unset.
META_CAPI_ACCESS_TOKEN=
# --- Admin dashboard. Server-only. Mark Sensitive in Vercel. Never commit real values. ---
# Login at /admin is refused until both are set. Do not invent values in source.
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=
# Optional. Strengthens the anonymous IP hash for traffic sessions. Raw IP addresses are not stored.
ANALYTICS_HASH_SECRET=
