# WIN 講師班 payment backend. Copy to Vercel env (mark keys Sensitive). Never commit real values.
# --- Elsa supplies (PAYUNi merchant dashboard) ---
PAYUNI_MER_ID=
PAYUNI_HASH_KEY=          # 32 chars
PAYUNI_HASH_IV=           # 16 chars
# --- Elsa supplies (Resend; sending domain must be verified) ---
RESEND_API_KEY=
RESEND_FROM=              # e.g. "WIN 課程團隊 <course@...>" (same as old site)
RESEND_REPLY_TO=          # optional
# --- We generate ---
PAYUNI_TEST_ACCESS=       # random 32+ byte secret; Bearer token for POST /api/payuni/test/create
DATABASE_URL=             # injected by the Neon Marketplace integration
# --- Optional ---
PAYUNI_TEST_EMAIL=        # NT$1 test receipt address (default floraloasis0211@gmail.com)
PAYUNI_API_ENDPOINT=      # default https://api.payuni.com.tw/api/upp (sandbox: https://sandbox-api.payuni.com.tw/api/upp)
